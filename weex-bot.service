[Unit]
Description=WEEX BTC Intraday Displacement Trading Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/weex-btc-displacement-bot
ExecStart=/usr/bin/python3 -u bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
