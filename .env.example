# WEEX V3 Contract API Credentials
WEEX_API_KEY=your_api_key_here
WEEX_API_SECRET=your_api_secret_here
WEEX_PASSPHRASE=your_passphrase_here
WEEX_BASE_URL=https://api-contract.weex.com

# Trading Parameters
SYMBOL=BTCUSDT
LEVERAGE=20
# Position Mode: 'LONG' or 'SHORT' (WEEX V3 Contract requirement)
POSITION_MODE=LONG

# Fixed Risk Per Trade in USD (Default: $1.00)
DOLLAR_RISK=1.00

# Strategy Targets & Settings
REWARD_RISK_RATIO=1.5
ATR_PERIOD=14
K_ATR=1.2
MIN_BODY_RATIO=0.65

# Target Session Times in UTC:
# 08:03 UTC -> London Cash Open + 8h Funding
# 13:33 UTC -> New York Cash Open (NYO)
# 16:03 UTC -> European Close / US Midday + 8h Funding
# 00:03 UTC -> Daily 1D Open / Asia + 8h Funding
SESSIONS=08:03,13:33,16:03,00:03
WINDOW_MINUTES=30
MAX_HOLD_MINUTES=60
MAX_TRADES_PER_WINDOW=1

# Safety Mode: true = Simulated Paper Trading, false = Live Real Orders
DRY_RUN=true
LOG_LEVEL=INFO
