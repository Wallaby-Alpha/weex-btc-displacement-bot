# WEEX V3 Contract API Credentials
WEEX_API_KEY=your_api_key_here
WEEX_API_SECRET=your_api_secret_here
WEEX_PASSPHRASE=your_passphrase_here
WEEX_BASE_URL=https://api-contract.weex.com

# Trading Parameters
SYMBOL=BTCUSDT
LEVERAGE=20

# Fixed Risk Per Trade in USD (Default: $1.00)
DOLLAR_RISK=1.00

# Strategy Targets & Settings
REWARD_RISK_RATIO=1.5
ATR_PERIOD=14
K_ATR=1.5
MIN_BODY_RATIO=0.65

# Target Session Times in UTC (e.g. 08:03, 16:03, 00:03)
# To also trade NY Open (9:33 AM ET = 13:33 UTC in summer / 14:33 UTC in winter), add it here
SESSIONS=08:03,16:03,00:03
WINDOW_MINUTES=30
MAX_HOLD_MINUTES=60
MAX_TRADES_PER_WINDOW=1

# Safety Mode: true = Simulated Paper Trading, false = Live Real Orders
DRY_RUN=true
LOG_LEVEL=INFO
